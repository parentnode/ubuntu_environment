alias git_acpp="sudo git add --all && sudo git commit -m 'auto add changes' && sudo git pull && sudo git push"


# Mod sec helpers
disable_sec_mod() {
	if [ -e "$1" ]
	then
		sudo mv "$1" "$1.dis"
		apache restart
	else
		echo "Wrong directory – go to /usr/share/modsecurity-crs/rules to use this method"
	fi
}
enable_sec_mod() {
	if [ -e "$1.dis" ]
	then
		sudo mv "$1".dis "$1"
		apache restart
	else
		echo "Wrong directory – go to /usr/share/modsecurity-crs/rules to use this method"
	fi
}

# service helper
service-exists() {
	[ $(systemctl list-unit-files "${1}*" | wc -l) -gt 3 ]
}
